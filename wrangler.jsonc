// Recharge sur Cloudflare Workers : le site et l'appli (dossier public/) + l'API des comptes (worker/index.js).
// Les secrets (RESEND_API_KEY…) ne sont JAMAIS ici : ils se règlent dans Cloudflare (Variables et secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recharge",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/playbook/*"]
  },
  // Base D1 (facultative) : sans elle, les comptes vivent dans le stockage STORE ci-dessous, créé automatiquement.
  // Pour utiliser D1 à la place, retirer les « // » ci-dessous et appliquer les fichiers de migrations/.
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "recharge",
  //     // identifiant de la base D1 « recharge » (Cloudflare › Stockage et bases de données › D1)
  //     "database_id": "00000000-0000-0000-0000-000000000000",
  //     "migrations_dir": "migrations"
  //   }
  // ],
  // Compteur d'échanges avec le coach IA (3 gratuits par mois) : créé automatiquement à la mise en ligne
  // Base des comptes (si aucune base D1 n'est branchée) : créée automatiquement à la mise en ligne
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "Quota" }, { "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Quota"] }, { "tag": "v2", "new_sqlite_classes": ["Store"] }],
  // Les fichiers .sql (tables des comptes) sont lus par le serveur
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": {
    // Adresse publique du site (sert à construire le lien de connexion envoyé par email)
    "APP_ORIGIN": "https://getrecharge.fr",
    // Expéditeur des emails (domaine getrecharge.fr validé dans Resend)
    "EMAIL_FROM": "Recharge <bonjour@getrecharge.fr>",
    // La sauvegarde en ligne est réservée aux abonnées (phase 3)
    "REQUIRE_PAID": "true",
    // Uniquement pour tester sans email : "true" renvoie le lien de connexion dans la réponse. Toujours "false" en ligne.
    "DEV_SHOW_LINK": "false"
  },
  "triggers": { "crons": ["17 * * * *"] },   // chaque heure : rappel J-1 de fin d'essai (worker/reminders.js)
  "observability": { "enabled": true }
}
